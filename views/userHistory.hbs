<!DOCTYPE html>
<html>
<head>
    <h4>User session</h4>
</head>
<body>


    <div class="container">
        <div class="row">
            <div class="col-md-8 col-md-offset-2">
                {{!-- Show the userName and email in the page title --}}
                <h2>{{session.user.userName}} ({{session.user.email}}) History</h2>

                {{!-- Table to display login history --}}
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Login Date/Time</th>
                            <th>Client Information</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each session.user.loginHistory}}
                        <tr>
                            <td>{{this.dateTime}}</td>
                            <td>{{this.userAgent}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Your other content goes here -->
</body>
</html>
